# Copy this file to `.env` for local dev, and set the same keys in Railway → Variables.

# The admin login password for the hidden #/admin article studio.
ADMIN_PASSWORD=choose-a-strong-password

# A long random string used to sign the admin session cookie.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Where articles.json is stored. Locally ./data is fine.
# On Railway, attach a Volume and set this to its mount path (e.g. /data) so
# articles survive restarts and redeploys.
DATA_DIR=./data
